--  Lector core (src/core): the SPARK-proven targeted JSON scans -- pure string
--  functions, zero IO, and ZERO external dependency.  It is deliberately
--  CONFIG-FREE: it does NOT with the Alire-generated config/lector_config.gpr,
--  because that config withs every crate dependency (aunit, utilada) and any
--  consumer withing lector.gpr would then inherit that foreign code in its
--  build and PROOF tree -- exactly what proof/proof.gpr avoids by sourcing
--  src/core directly.  So a consumer that withs lector.gpr gets the proven
--  core alone.  The utilada adapter (src/app) and the AUnit suite live in
--  lector_utilada.gpr / tests, which carry those dependencies; with those
--  projects explicitly to use Lector.Utilada or to run the tests.
project Lector is

   for Library_Name use "Lector";
   for Source_Dirs use ("src/core");
   for Object_Dir use "obj";
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("LECTOR_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      --  Ada 2022 for the core's expression functions / contracts. No profile
      --  externals here on purpose (see the config-free note above).
      for Default_Switches ("Ada") use ("-gnat2022");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Lector;
