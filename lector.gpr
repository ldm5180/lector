with "config/lector_config.gpr";
with "utilada_sys";

--  Lector: narrow JSON reading for consumers of REST payloads.  src/core
--  holds the SPARK-proven targeted scans (pure string functions, zero IO,
--  no dependencies beyond other core units); src/app holds the utilada
--  adapter (a whole-document parse into a flat property view, with
--  Ok : out Boolean instead of exceptions).  proof/proof.gpr sources
--  src/core directly and withs nothing, keeping foreign code out of the
--  proof tree.
project Lector is

   for Library_Name use "Lector";
   for Library_Version use
     Project'Library_Name & ".so." & Lector_Config.Crate_Version;

   for Source_Dirs use ("src/core", "src/app", "config");
   for Object_Dir use "obj/" & Lector_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("LECTOR_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use Lector_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Lector;
