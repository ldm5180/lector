with "config/lector_config.gpr";
with "lector.gpr";
with "utilada_sys";

--  The utilada adapter for Lector (src/app): a whole-document JSON parse into
--  a flat property view (Lector.Utilada), returning Ok : out Boolean instead
--  of raising.  Kept OUT of lector.gpr deliberately so a consumer that only
--  needs the SPARK-proven core (src/core) pulls no foreign code (utilada)
--  into its build or proof tree -- the same reason proof/proof.gpr isolates
--  the core.  With this project explicitly to use Lector.Utilada.
project Lector_Utilada is

   for Library_Name use "Lector_Utilada";
   for Library_Version use
     Project'Library_Name & ".so." & Lector_Config.Crate_Version;

   for Source_Dirs use ("src/app");
   for Object_Dir use "obj-utilada/" & Lector_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib-utilada";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("LECTOR_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use Lector_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Lector_Utilada;
